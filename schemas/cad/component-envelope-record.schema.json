{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AndreVazao/VAZAO-EVSE-Platform/blob/main/schemas/cad/component-envelope-record.schema.json",
  "title": "VAZAO EVSE component envelope provenance record",
  "description": "Machine-readable provenance, dimensional evidence and review-state record. Schema validates structure, not source authenticity or dimensional correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "identity",
    "lifecycle",
    "model_provenance",
    "sources",
    "dimensions",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturer",
        "designation",
        "manufacturer_part_number"
      ],
      "properties": {
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "designation": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer_part_number": {
          "type": "string",
          "minLength": 1
        },
        "variant_or_suffix": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "accessory_state": {
          "type": "string"
        }
      }
    },
    "lifecycle": {
      "enum": [
        "current",
        "active_but_obsolete",
        "discontinued",
        "unknown",
        "blocked_pending_confirmation"
      ]
    },
    "model_provenance": {
      "enum": [
        "manufacturer_original",
        "supplier_provided",
        "measured_reference",
        "derived_engineering",
        "third_party_unverified"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "class",
          "publisher",
          "title",
          "retrieved_on"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]{1,63}$"
          },
          "class": {
            "enum": [
              "A_manufacturer_controlled_drawing",
              "B_manufacturer_CAD",
              "C_manufacturer_datasheet",
              "D_verified_physical_measurement",
              "E_derived_engineering",
              "F_visual_or_unverified"
            ]
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "document_revision": {
            "type": "string"
          },
          "published_on": {
            "type": "string",
            "format": "date"
          },
          "retrieved_on": {
            "type": "string",
            "format": "date"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "controlled_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension_id",
          "name",
          "value",
          "unit",
          "definition",
          "evidence_class",
          "source_ids"
        ],
        "properties": {
          "dimension_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]{1,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "const": "mm"
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "axis_or_datum": {
            "type": "string"
          },
          "tolerance_plus_mm": {
            "type": "number",
            "minimum": 0
          },
          "tolerance_minus_mm": {
            "type": "number",
            "minimum": 0
          },
          "evidence_class": {
            "enum": [
              "A_manufacturer_controlled_drawing",
              "B_manufacturer_CAD",
              "C_manufacturer_datasheet",
              "D_verified_physical_measurement",
              "E_derived_engineering",
              "F_visual_or_unverified"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "method_or_calculation": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "model_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "sha256",
        "units"
      ],
      "properties": {
        "format": {
          "enum": [
            "FCStd",
            "STEP",
            "STP",
            "IGES",
            "IGS",
            "DXF",
            "DWG",
            "STL",
            "3MF",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "units": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_system": {
          "type": "string"
        },
        "orientation_transform": {
          "type": "string"
        },
        "original_source_immutable": {
          "type": "boolean"
        },
        "derived_from_record_id": {
          "type": "string"
        }
      }
    },
    "installation_envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includes_body_only": {
          "type": "boolean"
        },
        "separate_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "mating_space",
              "terminal_access",
              "cable_bend",
              "gland_entry",
              "tool_access",
              "ventilation",
              "heat_rejection",
              "door_swing",
              "service_removal",
              "mounting_hardware",
              "other"
            ]
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "unreviewed",
            "provisional",
            "verified_reference",
            "released_for_design",
            "rejected"
          ]
        },
        "reviewer_role": {
          "type": "string"
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "approval_scope": {
          "type": "string"
        },
        "second_person_review": {
          "type": "boolean"
        },
        "open_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
